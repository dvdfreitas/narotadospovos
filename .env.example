APP_NAME="Na Rota dos Povos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nrp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log: os emails ficam em storage/logs/laravel.log e nada sai do servidor.
# Para enviar a sério pela conta Google (Workspace) bazar@narotadospovos.org:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=bazar@narotadospovos.org
#   MAIL_PASSWORD=   <- palavra-passe de aplicação, não a da conta
# Testar sem comprar: php artisan bazar:testar-email o-seu@email.pt
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="bazar@narotadospovos.org"
MAIL_FROM_NAME="Na Rota dos Povos"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MYSQL_EXTRA_OPTIONS=

# MB Way — ver documentation/ifthenpay.md
IFTHENPAY_MBWAY_KEY=
IFTHENPAY_ANTI_PHISHING_KEY=
# production: pagamentos reais. fake: simulados, sem tocar na ifthenpay
# (qualquer telemóvel paga; 910000001 a 910000004 simulam falhas — ver FakeMbWayClient).
IFTHENPAY_ENV=production

# Emails das contas com acesso a /admin/pagamentos, separados por vírgulas.
ADMIN_EMAILS=
